# The worker image: the same application as the edge, plus the Opus command-line tools that decode voice notes and
# encode clips (opusdec, opusenc; BSD-3-Clause). No other media framework is installed (RQ-71, PL-36).
FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends opus-tools \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.11.32
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
RUN useradd -r -u 10001 saathi && mkdir -p /var/lib/saathi/media /var/lib/saathi/clips && chown -R saathi /var/lib/saathi
USER saathi
CMD ["saathi-worker"]
