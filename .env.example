# Copy to .env on the server (chmod 600). NEVER commit .env: it holds secrets
# and personal values. Generate secrets with: openssl rand -hex 32

# ---------- public endpoint (for the WhatsApp webhook) ----------
SAATHI_DOMAIN=saathi.example.com
SAATHI_PUBLIC_BASE_URL=https://saathi.example.com

# People, approvers, caps and names are NOT here: they are versioned household_config rows (saathi-admin).
SAATHI_TG_OPS_CHAT_ID=0

# ---------- database logins, one per runtime role (passwords below go into these URLs) ----------
SAATHI_DB_URL_EDGE=postgresql://saathi_edge:<password>@postgres:5432/saathi
SAATHI_DB_URL_CORE=postgresql://saathi_core:<password>@postgres:5432/saathi
SAATHI_DB_URL_MODEL=postgresql://saathi_model:<password>@postgres:5432/saathi
SAATHI_DB_URL_OWNER=postgresql://saathi_owner:<password>@postgres:5432/saathi

# ---------- paths and technical constants ----------
SAATHI_MEDIA_DIR=/var/lib/saathi/media
SAATHI_TRACE_DIR=/var/lib/saathi/traces
SAATHI_HEALTH_PATH=/health
SAATHI_ENV=prod                    # deployment name; compose passes it to the services (prod by default)
SAATHI_SECRETS_DIR=/etc/saathi/secrets   # host directory of the secret files (mode 600 each), mounted at /run/secrets

# ---------- secret files (each its own secret; mounted only into the service that needs it) ----------
SAATHI_KEK_FILE=                   # key-encryption key, 32 bytes; worker only
SAATHI_SENDER_HMAC_KEY_FILE=       # sender hash key of the edge
SAATHI_APPROVAL_SECRET_FILE=       # optional: a file instead of SAATHI_APPROVAL_SECRET below

# ---------- secrets ----------
SAATHI_APPROVAL_SECRET=            # >= 32 bytes; signs approval tokens
POSTGRES_PASSWORD=
SAATHI_DB_PASSWORD_MIGRATOR=
SAATHI_DB_PASSWORD_EDGE=
SAATHI_DB_PASSWORD_CORE=
SAATHI_DB_PASSWORD_MODEL=
SAATHI_DB_PASSWORD_OWNER=
SAATHI_DB_PASSWORD_READONLY=
VALKEY_PASSWORD=
CLICKHOUSE_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=           # 64 hex chars
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ADMIN_EMAIL=
LANGFUSE_ADMIN_PASSWORD=
SAATHI_LANGFUSE_PUBLIC_KEY=pk-lf-saathi
SAATHI_LANGFUSE_SECRET_KEY=        # sk-lf-... choose any random value

# ---------- WhatsApp Business Cloud API ----------
SAATHI_WA_PHONE_NUMBER_ID=
SAATHI_WA_ACCESS_TOKEN=
SAATHI_WA_APP_SECRET=
SAATHI_WA_VERIFY_TOKEN=
SAATHI_WA_WEBHOOK_PATH=            # random path segment: the webhook is /wa/<segment>

# ---------- Telegram ----------
SAATHI_TG_CAREGIVER_TOKEN=
SAATHI_TG_ELDER_TOKEN=
SAATHI_TG_ELDER_SECRET=
SAATHI_TG_ELDER_WEBHOOK_PATH=      # random path segment: Phase 1 webhook is /tg/elder/<segment>

# ---------- model tiers (chat-completions-compatible endpoints; empty = disabled) ----------
SAATHI_T1_MODEL=<local model tag>
SAATHI_T2_BASE_URL=
SAATHI_T2_API_KEY=
SAATHI_T2_MODEL=
SAATHI_T2_VISION_MODEL=
SAATHI_T2_FREE_BASE_URL=           # free tier: NON-PERSONAL data only (enforced in code)
SAATHI_T2_FREE_API_KEY=
SAATHI_T2_FREE_MODEL=
SAATHI_T3_BASE_URL=
SAATHI_T3_API_KEY=
SAATHI_T3_MODEL=
SAATHI_T4_BASE_URL=
SAATHI_T4_API_KEY=
SAATHI_T4_MODEL=
SAATHI_ROSTER_PATH=                      # private roster file; schema in infra/roster.example.toml
SAATHI_LEDGER_SCOPE=global               # global = one cap across all households; household = one cap each
SAATHI_LEDGER_TZ=Asia/Kolkata            # the month of the cap follows this time zone (IANA name)

# ---------- ASR ----------
SAATHI_ASR_PROVIDER=whispercpp
WHISPER_MODEL=<whisper model name>
WHISPER_MODEL_URL=<whisper model download url>
